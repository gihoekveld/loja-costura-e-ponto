# =========================================================================
# COSTURA & PONTO — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# =========================================================================
# Copie este arquivo para .env.local para desenvolvimento local:
#   cp .env.example .env.local
#
# Em produção (Cloudflare Pages), adicione estas variáveis no painel:
#   Settings > Environment variables > Production > Encrypt
# =========================================================================

# Chave Mestra Criptográfica (AES-256-GCM - LGPD)
# Utilizada para criptografia reversível de documentos sensíveis (CPF) para fins fiscais.
# Deve conter no mínimo 32 bytes de entropia (ex: 64 caracteres hexadecimais).
DATA_ENCRYPTION_KEY=coloque_aqui_uma_chave_secreta_com_256_bits_de_entropia

# Sal Secreto da Aplicação para CPF (SHA-256 Pepper - LGPD)
# Utilizado para geração de hash determinístico de busca sem expor o CPF em texto claro.
# Deve conter no mínimo 32 bytes de entropia (ex: 64 caracteres hexadecimais).
CPF_HASH_PEPPER=coloque_aqui_um_pepper_secreto_com_256_bits_de_entropia
